NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# which country this instance is for — controls branding and feature defaults (ag | gd | lc | vc)
NEXT_PUBLIC_COUNTRY_CODE=ag

# not used in the demo (in-memory store) — fill in for a real deployment
DATABASE_URL=postgresql://app_user:password@localhost:5432/consumer_affairs

# generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# these stay empty until the inter-agency MOU with Customs is signed and Customs IT issues credentials
# the module falls back to manual flat-file upload when ASYCUDA_ENABLED is false
ASYCUDA_API_URL=
ASYCUDA_API_KEY=
# country tenant ID in ASYCUDA World — from UNCTAD support
ASYCUDA_TENANT_ID=
# read-only service account provisioned by Customs IT for the scheduled pull
ASYCUDA_USERNAME=
ASYCUDA_PASSWORD=
# cron schedule for the automated pull — default is once daily at 06:00
ASYCUDA_SYNC_CRON=0 6 * * *
# flip to true once API access is confirmed
ASYCUDA_ENABLED=false

# notifications go to work email addresses only, never personal ones
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@consumer.gov.ag

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# local works for on-premise; switch to s3 and fill in the AWS vars for cloud storage
STORAGE_PROVIDER=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=consumer-affairs-uploads
